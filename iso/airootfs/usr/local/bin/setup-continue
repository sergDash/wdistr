#!/bin/sh
# Фаза 2 установки wdistr — закачка пакетов и настройка целевой системы:
#
#     setup-continue <имя_пользователя> <пароль> <диск>
#
# Разметка здесь НЕ делается: диск должен быть уже размечен фазой 1
# (команда setup делает это сама и сразу вызывает setup-continue).
#
# setup-continue — штатный этап и точка возобновления (решение 2026-10-14):
# если сеть оборвала закачку, повторите эту команду с теми же
# аргументами — диск не переразмечается, кэш частично скачанных пакетов
# (/var/cache/pacman/pkg на целевом) цел и переиспользуется, докачивается
# только недостающее. Разметка отобрана у archinstall: единый проход
# означал бы при повторе стирание диска вместе с кэшем.
#
# Механика: разделы монтируются вручную, archinstall запускается в
# режиме pre_mounted_config (ставит систему на смонтированное, ничего
# не стирая), после — обычная доставка файлов из живой среды.

usage() {
    echo "Использование: setup-continue <имя_пользователя> <пароль> <диск>"
    echo "Пример:       setup-continue ivan 12345 /dev/sda"
    echo
    echo "Это фаза 2 установки (закачка и настройка). Обычно её запускает"
    echo "setup автоматически после разметки. Повтор вручную нужен, если"
    echo "установка оборвалась (сеть) — тогда продолжение идёт без"
    echo "переразметки диска."
    echo
    echo "Доступные диски:"
    echo
    disks
    exit 1
}

[ -z "$3" ] && usage

# Проверки целевого устройства: только целый диск, не раздел и не мусор
if [ ! -b "$3" ]; then
    echo "ОШИБКА: '$3' — не блочное устройство." >&2
    echo >&2
    usage
fi
if [ "$(lsblk -dnno TYPE "$3" 2>/dev/null)" != "disk" ]; then
    echo "ОШИБКА: '$3' — нужен целый диск, а не раздел. Вывод lsblk ниже." >&2
    echo >&2
    usage
fi

# Размечен ли диск фазой 1: ищем vfat (загрузочный) и btrfs (корень)
BOOT_PART=$(lsblk -lnpo NAME,FSTYPE "$3" | awk '$2=="vfat"{print $1; exit}')
ROOT_PART=$(lsblk -lnpo NAME,FSTYPE "$3" | awk '$2=="btrfs"{print $1; exit}')
if [ -z "$ROOT_PART" ] || [ -z "$BOOT_PART" ]; then
    echo "ОШИБКА: на $3 нет разделов vfat+btrfs — диск не размечен." >&2
    echo "Сначала выполните: setup <имя> <пароль> $3" >&2
    exit 1
fi

# Проверка сабволюмов @ и @home: монтируем top-level временно и смотрим.
# Без них ставить некуда — честный отказ вместо частичной установки.
umount -R /mnt 2>/dev/null
if ! mount "$ROOT_PART" /mnt; then
    echo "ОШИБКА: не смонтировался корень btrfs ($ROOT_PART)." >&2
    exit 1
fi
SUBVOLS_OK=1
[ -d /mnt/@ ] && [ -d /mnt/@home ] || SUBVOLS_OK=0
umount /mnt
if [ "$SUBVOLS_OK" -ne 1 ]; then
    echo "ОШИБКА: на $ROOT_PART нет сабволюмов @ и @home —" >&2
    echo "диск размечен не этой установкой. Выполните: setup <имя> <пароль> $3" >&2
    exit 1
fi

CREDS=/var/tmp/wdistr-creds.json
CONFIG=/var/tmp/wdistr-config.json

# Диск ($3) тоже уходит в python — сообщение об остановке печатает
# готовую команду продолжения с аргументами пользователя
python3 - "$1" "$2" "$3" "$CREDS" "$CONFIG" <<'PYEOF' || exit 1
import json
import pathlib
import sys
import time
import urllib.request

name, password, disk, creds_path, config_path = sys.argv[1:6]

# Учётные данные: один пароль для пользователя и root
pathlib.Path(creds_path).write_text(json.dumps({
    "users": [{"username": name, "sudo": True, "!password": password}],
    "!root-password": password,
}, indent=4))

config = json.loads(pathlib.Path('/root/wdistr/archinstall-config.json').read_text())

# Разметку делает фаза 1 своими руками (parted/mkfs/sabволюмы) — для
# archinstall диск объявляется пред-монтированным (pre_mounted_config):
# он ставит систему в /mnt и ничего не стирает. Режим есть в archinstall
# 4.5 (DiskLayoutType.Pre_mount, models/device.py).
config['disk_config'] = {
    'config_type': 'pre_mounted_config',
    'mountpoint': '/mnt',
}

# Зеркала: проба каждого, остановка установки — только когда не ответило
# НИ ОДНО. Почему стоп: archinstall запускается с --offline, сеть он сам
# не проверяет — без остановки pacstrap полез бы в мёртвые зеркала и завис
# на таймаутах, сбой случился бы посреди закачки.
# Почему полный список, а не отсеивание мёртвых: archinstall в --offline
# собирает Server-строки из локального /etc/pacman.d/mirrorlist по имени
# региона, а URL-ы из конфига не читает (archinstall 4.5, regions_config) —
# отсеивание в конфиг ни на что не влияло, его результат был мёртвым кодом
# (разбор 2026-10-15). Полный список к тому же самовосстанавливается:
# ожившее посреди установки зеркало pacman берёт на следующем файле.
# Круги проб: однократная давала ложное «всё мертво» на кратковременной
# просадке (опыт 2026-10-15: при сборке ISO cdnmirror ~10 с отдавал
# <1 байт/с, truenetwork не резолвился; минуту спустя оба были живы).
# Поимённый вывод результатов (запрос 2026-10-14) остаётся: по нему
# видно, какое зеркало отвалилось и почему.
regions = config.get('mirror_config', {}).get('mirror_regions', {})
PROBE_ROUNDS = 3
PROBE_PAUSE = 3  # секунд между кругами

alive = 0
for round_nr in range(1, PROBE_ROUNDS + 1):
    if round_nr > 1:
        print(f'  ни одно зеркало не ответило, повтор {round_nr}/{PROBE_ROUNDS} через {PROBE_PAUSE} с')
        time.sleep(PROBE_PAUSE)
    alive = 0
    for region_name, urls in regions.items():
        ok = 0
        for url in urls:
            probe = url.replace('$repo', 'core').replace('$arch', 'x86_64')
            try:
                req = urllib.request.Request(
                    probe, headers={'Range': 'bytes=0-0', 'User-Agent': 'wdistr-setup'})
                with urllib.request.urlopen(req, timeout=4) as resp:
                    resp.read(1)
                print(f'  [доступно]   {url}')
                ok += 1
                alive += 1
            except Exception as exc:
                detail = f'{type(exc).__name__}: {exc}'
                print(f'  [НЕ доступно] {url}  ({detail[:80]})')
        print(f'зеркала ({region_name}): доступно {ok} из {len(urls)}')
    if alive:
        break

# Отказ чистый: остановка до записи конфига archinstall, монтирования
# разделов и закачки. Сообщение печатает ГОТОВУЮ команду продолжения
# с аргументами: «повторите команду» сбивало — повтор setup переразмечал
# диск, а продолжение это фаза 2 (опыт 2026-10-15: кабель отключён,
# установка встала, непонятно что именно повторять).
if regions and not alive:
    # flush: stdout в пирпе буферизуется целиком, без сброса печать
    # ошибки из stderr опережает строки проб в логе
    sys.stdout.flush()
    print(f'ОШИБКА: ни одно из зеркал не ответило за {PROBE_ROUNDS} круга проб —'
          ' установка остановлена.', file=sys.stderr)
    print('Проверьте сеть и продолжите установку командой (разметка фазы 1'
          ' цела, диск НЕ переразмечается — возобновится только закачка):',
          file=sys.stderr)
    print(f'    setup-continue {name} {password} {disk}', file=sys.stderr)
    sys.exit(1)

pathlib.Path(config_path).write_text(json.dumps(config, indent=4))
PYEOF

# Монтируем целевую в /mnt: сабволюмы @, @home и загрузочный раздел.
# archinstall в pre_mounted-режиме увидит смонтированное дерево и
# построит по нему fstab. Каталоги home и boot в свежем сабволюме @
# пусты — mount отказал бы без точек монтирования (ошибка 2026-10-14).
umount -R /mnt 2>/dev/null
mount -o subvol=/@ "$ROOT_PART" /mnt || {
    echo "ОШИБКА: сабволюм @ не смонтировался." >&2
    exit 1
}
mkdir -p /mnt/home /mnt/boot
mount -o subvol=/@home "$ROOT_PART" /mnt/home || {
    echo "ОШИБКА: сабволюм @home не смонтировался." >&2
    exit 1
}
mount "$BOOT_PART" /mnt/boot || {
    echo "ОШИБКА: загрузочный раздел не смонтирован в /mnt/boot." >&2
    exit 1
}

# Повтор установки: если пользователь уже создан первой попыткой, не
# включаем его в creds — иначе archinstall падает на useradd с «already
# exists» (exit status 9, опыт 2026-10-15: первый проход успел создать
# юзера, sudoers и home, обрыв был после; повторный прогон дошёл до
# create_users и упал). Проверка после монтирования — только здесь
# целевая видна; сравнение точное, не по regex (имя приходит от
# пользователя). Root-пароль в creds остаётся: archinstall просто
# перезапишет его тем же значением.
python3 - "$1" "$CREDS" <<'PYEOF'
import json
import sys

name, creds_path = sys.argv[1:3]
creds = json.loads(open(creds_path).read())
for line in open('/mnt/etc/passwd'):
    if line.split(':', 1)[0] == name:
        creds['users'] = []
        print(f"Повтор: пользователь '{name}' уже в целевой — "
              'создавать заново не будем.')
        break
open(creds_path, 'w').write(json.dumps(creds, indent=4))
PYEOF

# --offline: archinstall берёт зеркала из локального mirrorlist (наш
# статический список из mirrors.txt), а не с archlinux.org/mirrors/status —
# иначе он возьмёт глобальный список по имени региона, игнорируя URL из
# конфига (случай 2026-10-08: archlinux.gay из такого списка сорвал
# pacstrap). Побочно отключает проверку сети
# и pacman -Sy на старте — сеть уже проверена пробами зеркал выше.
archinstall \
    --config "$CONFIG" \
    --creds "$CREDS" \
    --silent \
    --offline
ARCH_RC=$?

# Код archinstall — основной признак успеха (опыт 2026-10-14: при
# прерванной закачке pacstrap падал — ненулевой код это и ловит).
# При провале НЕ переразмечаем: повторите setup-continue с теми же аргументами,
# докачается только недостающее.
if [ "$ARCH_RC" -ne 0 ]; then
    echo "ОШИБКА: archinstall завершился с кодом $ARCH_RC — установка НЕ завершена." >&2
    echo "Частая причина — прерванная закачка пакетов (сеть)." >&2
    echo "Повторите setup-continue с теми же аргументами: диск НЕ переразмечается," >&2
    echo "уже скачанные пакеты переиспользуются, докачается только недостающее." >&2
    exit 1
fi

# Доставка файлов из живой среды в целевую (решение 2026-10-12):
# бинарник opencode и шрифты Windows не влезают в base64 custom_commands,
# остальное — курсоры, тема, карты keyd, консоль.
# Счётчик сбоев доставки: суммируем и печатаем в конце, чтобы частичная
# доставка не осталась незамеченной (тихая поломка хуже громкой)
FAIL=0
for f in /usr/local/bin/opencode /usr/local/bin/opencode-*; do
    [ -e "$f" ] || continue
    mkdir -p /mnt/usr/local/bin
    if ! cp -a "$f" /mnt/usr/local/bin/; then
        echo "ОШИБКА доставки: $f -> /mnt/usr/local/bin/" >&2
        FAIL=$((FAIL + 1))
    fi
done
if ! cp -a /usr/share/fonts/winfonts /mnt/usr/share/fonts/ 2>/dev/null; then
    mkdir -p /mnt/usr/share/fonts
    if ! cp -a /usr/share/fonts/winfonts /mnt/usr/share/fonts/; then
        echo "ОШИБКА доставки: /usr/share/fonts/winfonts -> /mnt/usr/share/fonts/" >&2
        FAIL=$((FAIL + 1))
    fi
fi

# Консоль с кириллицей (опыт 2026-10-12): конфиг vconsole и шрифт
# ter-u16n из состава лайва. Без них в целевой после тапа Shift русские
# буквы печатаются квадратиками — airootfs в целевую не копируется,
# а terminus-font в её составе нет
if ! cp -a /etc/vconsole.conf /mnt/etc/vconsole.conf; then
    echo "ОШИБКА доставки: /etc/vconsole.conf" >&2
    FAIL=$((FAIL + 1))
fi
mkdir -p /mnt/usr/share/kbd/consolefonts
if ! cp -a /usr/share/kbd/consolefonts/ter-u16n.psf.gz /mnt/usr/share/kbd/consolefonts/; then
    echo "ОШИБКА доставки: /usr/share/kbd/consolefonts/ter-u16n.psf.gz" >&2
    FAIL=$((FAIL + 1))
fi

# Курсоры, тема дистрибутива и карты раскладок keyd — бывшие большие
# base64-доставки (переезд 2026-10-12): каталоги копируются целиком
mkdir -p /mnt/usr/share/icons /mnt/usr/share/themes
for d in /usr/share/icons/McMojave-cursors /usr/share/themes/Mint-Y-Dark-Aqua-10; do
    if ! cp -a "$d" "/mnt${d}"; then
        echo "ОШИБКА доставки: $d" >&2
        FAIL=$((FAIL + 1))
    fi
done
mkdir -p /mnt/usr/local/share/keyd
if ! cp -a /usr/local/share/keyd/us.txt /usr/local/share/keyd/ru.txt /mnt/usr/local/share/keyd/; then
    echo "ОШИБКА доставки: карты раскладок keyd (us.txt, ru.txt)" >&2
    FAIL=$((FAIL + 1))
fi

if [ "$FAIL" -eq 0 ]; then
    echo "Доставка из живой среды готова: opencode, шрифты Windows, курсоры, тема, карты keyd, консоль (vconsole + ter-u16n)."
else
    echo "ВНИМАНИЕ: не доехало файлов: $FAIL — сообщения выше." >&2
fi

umount /mnt/home /mnt/boot /mnt
echo
echo "Установка завершена (код archinstall: $ARCH_RC). Перезагрузитесь"
echo "и уберите установочный носитель. Вход: $1 / ваш пароль."
