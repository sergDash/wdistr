#!/bin/sh
# Установка нашей системы одной командой (двухфазная, решение 2026-10-14):
#
#     setup <имя_пользователя> <пароль> <диск>
#
# Фаза 1 (этот скрипт, офлайн): проверки диска и РАЗМЕТКА СВОИМИ
# руками — parted, mkfs, сабволюмы @ и @home. Разметка отобрана у
# archinstall: единый проход означал бы, что повтор после обрыва сети
# стирает диск вместе с кэшем частично скачанных пакетов.
#
# Фаза 2 (команда setup-continue, сеть): закачка пакетов и настройка через
# archinstall в режиме pre_mounted_config — на уже размеченном. При
# обрыве сети повторяется только setup-continue, диск не трогается, кэш
# pacstrap переиспользуется.
#
# Пароль передаётся открытым текстом намеренно: живая среда одноразовая,
# а открытый аргумент избавляет от опечаток при скрытом вводе (символы
# не видны). Один пароль — для пользователя и для root.
# Список дисков: команда `disks` либо просто `setup` без аргументов — тогда
# печатается эта же справка и под ней список дисков.

usage() {
    echo "Использование: setup <имя_пользователя> <пароль> <диск>"
    echo "Пример:       setup ivan 12345 /dev/sda"
    echo
    echo "Установка двухфазная: setup размечает диск, setup-continue ставит"
    echo "систему. Повтор после обрыва сети: setup-continue с теми же"
    echo "аргументами — без переразметки."
    echo
    echo "Список дисков: запустите «setup» без аргументов или команду «disks»."
    echo "Пароль уйдёт открытым текстом — это осознанный выбор для живой среды."
    echo
    echo "Доступные диски:"
    echo
    disks
    exit 1
}

[ -z "$3" ] && usage

# Проверки целевого устройства: только целый диск, не раздел и не мусор
if [ ! -b "$3" ]; then
    echo "ОШИБКА: '$3' — не блочное устройство." >&2
    echo >&2
    usage
fi
if [ "$(lsblk -dnno TYPE "$3" 2>/dev/null)" != "disk" ]; then
    echo "ОШИБКА: '$3' — нужен целый диск, а не раздел. Вывод lsblk ниже." >&2
    echo >&2
    usage
fi

# Размер диска в байтах — для расчёта конца корневого раздела
DISK_SIZE=$(lsblk -bdno "$3" 2>/dev/null | tr -d ' ')
case "$DISK_SIZE" in
    ''|*[!0-9]*)
        echo "ОШИБКА: не удалось определить размер диска '$3'." >&2
        exit 1
        ;;
esac

# Схема разделов — как у archinstall default_layout (воспроизведена
# 2026-10-14): загрузочный 1 ГиБ с 1 МиБ, корень — остаток диска.
# END_MARGIN: в конце GPT резервная копия таблицы — 33 сектора; после
# округления вниз вычитаем целый мегабайт (опыт 2026-10-09: на кратных
# МиБ дисках остаток ноль и parted жалуется на упор в резерв).
END_MARGIN=1048576
BOOT_END_MB=1025                      # 1 МиБ отступ + 1 ГиБ загрузочный
ROOT_END_MB=$(( (DISK_SIZE - END_MARGIN) / 1048576 ))
ROOT_BYTES=$(( (ROOT_END_MB - BOOT_END_MB) * 1048576 ))
if [ "$ROOT_BYTES" -lt $((4 * 1024 * 1024 * 1024)) ]; then
    echo "ОШИБКА: диск $3 ($DISK_SIZE байт) слишком мал — на корень" >&2
    echo "остаётся $ROOT_BYTES байт, нужно минимум 4 ГиБ." >&2
    exit 1
fi

echo "== фаза 1/2: разметка $3 (диск $((DISK_SIZE / 1048576)) МиБ, корень до ${ROOT_END_MB} МиБ) =="

# Таблица: GPT на UEFI (ESP-флаг обязателен, без него UEFI не видит
# раздел — опыт 2026-10-09), MBR на BIOS (тестовая VM)
if [ -d /sys/firmware/efi ]; then
    TABLE=gpt
else
    TABLE=msdos
fi

parted -s "$3" mklabel "$TABLE" || {
    echo "ОШИБКА: parted не создал таблицу $TABLE на $3." >&2
    exit 1
}
parted -s "$3" mkpart primary fat32 1MiB "${BOOT_END_MB}MiB" || exit 1
if [ "$TABLE" = "gpt" ]; then
    parted -s "$3" set 1 esp on || exit 1
    parted -s "$3" set 1 boot on || exit 1
else
    parted -s "$3" set 1 boot on || exit 1
fi
parted -s "$3" mkpart primary btrfs "${BOOT_END_MB}MiB" "${ROOT_END_MB}MiB" || exit 1
partprobe "$3" 2>/dev/null
udevadm settle 2>/dev/null

BOOT_PART="${3}1"
ROOT_PART="${3}2"
# Ждём появления разделов у udev (на NVMe/sda имена одинаковы —
# номер после имени диска)
tries=0
while [ ! -b "$BOOT_PART" ] || [ ! -b "$ROOT_PART" ]; do
    tries=$((tries + 1))
    if [ "$tries" -gt 20 ]; then
        echo "ОШИБКА: разделы $BOOT_PART/$ROOT_PART не появились." >&2
        exit 1
    fi
    sleep 0.5
done

mkfs.fat -F32 "$BOOT_PART" || {
    echo "ОШИБКА: mkfs.fat на $BOOT_PART." >&2
    exit 1
}
mkfs.btrfs -f "$ROOT_PART" || {
    echo "ОШИБКА: mkfs.btrfs на $ROOT_PART." >&2
    exit 1
}

# Сабволюмы @ и @home — по структуре из конфига archinstall (@ → /,
# @home → /home). Создаём в top-level, монтирование делает фаза 2.
umount -R /mnt 2>/dev/null
mount "$ROOT_PART" /mnt || {
    echo "ОШИБКА: не смонтировался свежий btrfs ($ROOT_PART)." >&2
    exit 1
}
btrfs subvolume create /mnt/@ || {
    umount /mnt
    echo "ОШИБКА: не создался сабволюм @." >&2
    exit 1
}
btrfs subvolume create /mnt/@home || {
    umount /mnt
    echo "ОШИБКА: не создался сабволюм @home." >&2
    exit 1
}
umount /mnt

echo "== фаза 1/2 завершена: разметка готова, эстафета в setup-continue =="

# Фаза 2 — закачка и настройка (сеть); при обрыве её можно повторить
# отдельно: setup-continue <имя> <пароль> <диск>
setup-continue "$1" "$2" "$3"
