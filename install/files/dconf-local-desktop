# Поведение рабочего стола wdistr (решение 2026-10-15).
# Значения сняты с рабочей машины, где настроены руками, и продублированы
# в cinnamon-defaults.sh (маркер: только при первом входе) — паттерн
# одинаков для тем, шрифтов и этих настроек.
#
# Заставка не запускается никогда (idle-delay=0 = «Never» в списке
# «Delay before starting the screensaver» модуля cs_screensaver):
# блокировка по простоям не нужна. Монитор гаснет через час простоя
# (не 30 минут дефолта — вкус пользователя). Кнопка питания — сразу
# выключение, а не засыпка (дефолт схемы 'suspend').
[org/cinnamon/desktop/session]
idle-delay=uint32 0

[org/cinnamon/settings-daemon/plugins.power]
sleep-display-ac=3600
button-power='shutdown'

# Съёмные носители: переключатель «Спрашивать или запускать программы
# при подключении носителя» — выключен. Виджет инвертирует ключ
# (InvertedSwitch в cs_default.py): выключен = autorun-never=true,
# дефолт схемы false. При подключении носителя не выскакивает диалог
# с выбором приложения (решение 2026-10-15, значение с рабочей машины).
[org/cinnamon/desktop/media-handling]
autorun-never=true

# Панель задач (решение 2026-10-16): меню и список окон в центральной
# зоне без разделителя, высота 60, иконки 32/26 — значения с рабочей
# машины. Дубль в cinnamon-defaults.sh (Cinnamon при первом входе
# перебивает пользовательский dconf своим дефолтом панели).
[org/cinnamon]
enabled-applets=['panel1:center:0:menu@cinnamon.org:0', 'panel1:center:1:grouped-window-list@cinnamon.org:2', 'panel1:right:0:systray@cinnamon.org:3', 'panel1:right:1:xapp-status@cinnamon.org:4', 'panel1:right:2:notifications@cinnamon.org:5', 'panel1:right:3:printers@cinnamon.org:6', 'panel1:right:4:removable-drives@cinnamon.org:7', 'panel1:right:5:keyboard@cinnamon.org:8', 'panel1:right:6:favorites@cinnamon.org:9', 'panel1:right:7:network@cinnamon.org:10', 'panel1:right:8:sound@cinnamon.org:11', 'panel1:right:9:power@cinnamon.org:12', 'panel1:right:10:calendar@cinnamon.org:13', 'panel1:right:11:cornerbar@cinnamon.org:14']
panels-height=['1:60']
panel-zone-icon-sizes=[{'panelId': 1, 'left': 0, 'center': 0, 'right': 32}]
panel-zone-symbolic-icon-sizes=[{'panelId': 1, 'left': 28, 'center': 28, 'right': 26}]
