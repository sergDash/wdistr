# Ghostty: настройки дистрибутива wdistr (значения с рабочей машины,
# решение 2026-10-17). Кладётся в ~/.config/ghostty/config первого
# пользователя при установке (custom_commands).
#
# ВНИМАНИЕ: путь несистемный. Ghostty читает конфиг ТОЛЬКО из
# XDG_CONFIG_HOME (~/.config/ghostty/config) — XDG_CONFIG_DIRS
# (/etc/xdg/ghostty/config) он игнорирует (проверено 2026-10-17:
# системный файл доехал в цель, но +show-config его не видел).
#
# window-decoration = server — рамка окна родная (рисует менеджер окон),
# не рисует её сам Ghostty. Размер окна — 120×40 (пожелание 2026-10-18;
# прежние 250×80 с рабочей машины пересмотрены).
window-decoration = server
window-width = 120
window-height = 40

# Скроллбэк большой — 200 МБ в байтах (удобно читать длинные логи)
scrollback-limit = 200_000_000

# Шрифт: Ubuntu Mono из базового набора; CJK-фоллбек для иероглифов
# (Ubuntu Mono их не содержит)
font-size = 12
font-family = Ubuntu Mono
font-family = Noto Sans Mono CJK SC

# Цветовые схемы по порядку: берётся первая доступная (ghostty
# +list-themes — полный список)
theme = Andromeda
theme = Adwaita Dark

# Комбинации кнопок (как на рабочей машине): Ctrl+C — копирование
# только при выделении (performable), Ctrl+V — вставка, Ctrl+Shift+Е/Ц —
# новая вкладка и закрытие (кириллические клавиши — раскладка RU;
# в US это T и H)
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+е=new_tab
keybind = ctrl+shift+ц=close_tab:this

# Колесо: множитель 3 отменён (пожелание 2026-10-18) — оставлена
# штатная скорость скролла Ghostty
# mouse-scroll-multiplier = 3
