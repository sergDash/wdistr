#!/usr/bin/env bash
# Сборка ISO wdistr одной командой:
#
#     sudo wdistr-build-iso <путь-к-репозиторию>
#
# Чистка work/ и запуск mkarchiso живут в одной обёртке, потому что для
# неё стоит одно NOPASSWD-правило в sudoers (wheel-build, пишет первый
# запуск): отдельный безпарольный rm был бы дырой, а два отдельных
# правил (rm + mkarchiso) хрупки и неудобны. Замена polkit-диалогам
# при сборке (решение 2026-10-12).
#
# Путь к репозиторию — аргумент: скрипт ставится в /usr/local/bin,
# а живёт репозиторий в разных местах.
set -euo pipefail

REPO="${1:?Использование: sudo wdistr-build-iso <путь-к-репозиторию>}"
if [ "$(id -u)" -ne 0 ]; then
    echo "Запускать через sudo: sudo wdistr-build-iso <путь-к-репозиторию>" >&2
    exit 1
fi
REPO="$(realpath -- "$REPO")"
if [ ! -f "$REPO/iso/profiledef.sh" ]; then
    echo "ОШИБКА: '$REPO' не похож на репозиторий wdistr (нет iso/profiledef.sh)." >&2
    exit 1
fi

# Снятие случайных монтирований внутри work/. Опыт 2026-10-18: после
# падения сборки под airootfs остался смонтированный /proc (pacstrap
# не распустил), rm -rf по нему ходит, а mkarchiso умирал на find по
# live-/proc. Опыт 2026-10-19: /proc остался ВНУТРИ удачно начатой
# сборки — mkarchiso умер на своей чистке pacstrap, ISO не создан.
# umount -R не годится: work/ сам не mountpoint — идём по строкам
# /proc/mounts глубже вглубь. «|| true» обязателен: при пустом выводе
# grep возвращает 1, и под pipefail скрипт умирал бы молча (опыт
# 2026-10-18: сборка не стартовала при чистом work/).
unmount_work() {
    grep " $REPO/work/" /proc/mounts | cut -d' ' -f2 | sort -r | \
        while read -r m; do umount -- "$m" 2>/dev/null || true; done || true
}

# Маркеры mkarchiso живут в work/: без чистки повторный запуск молча
# пропускает шаги и завершается «успехом» без ISO (случай 2026-09-26).
unmount_work
rm -rf -- "$REPO/work"

# При любом выходе (падение mkarchiso, Ctrl+C, ошибка обёртки)
# снимаем монтирования, оставшиеся в work/: без этого следующий запуск
# стартует с примонтированным /proc (опыт 2026-10-19). exec mkarchiso
# убран — он заменяет процесс обёртки, и падсказка не отработала бы.
trap unmount_work EXIT

# Выход в iso/out (читает тестовый стенд vm/create-test-vm.sh),
# профиль — явным путём от корня репозитория
mkarchiso -v -w "$REPO/work" -o "$REPO/iso/out" "$REPO/iso"
