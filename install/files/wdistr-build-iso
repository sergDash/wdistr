#!/usr/bin/env bash
# Сборка ISO wdistr одной командой:
#
#     sudo wdistr-build-iso <путь-к-репозиторию>
#
# Чистка work/ и запуск mkarchiso живут в одной обёртке, потому что для
# неё стоит одно NOPASSWD-правило в sudoers (wheel-build, пишет первый
# запуск): отдельный безпарольный rm был бы дырой, а два отдельных
# правил (rm + mkarchiso) хрупки и неудобны. Замена polkit-диалогам
# при сборке (решение 2026-10-12).
#
# Путь к репозиторию — аргумент: скрипт ставится в /usr/local/bin,
# а живёт репозиторий в разных местах.
set -euo pipefail

REPO="${1:?Использование: sudo wdistr-build-iso <путь-к-репозиторию>}"
if [ "$(id -u)" -ne 0 ]; then
    echo "Запускать через sudo: sudo wdistr-build-iso <путь-к-репозиторию>" >&2
    exit 1
fi
REPO="$(realpath -- "$REPO")"
if [ ! -f "$REPO/iso/profiledef.sh" ]; then
    echo "ОШИБКА: '$REPO' не похож на репозиторий wdistr (нет iso/profiledef.sh)." >&2
    exit 1
fi

# Маркеры mkarchiso живут в work/: без чистки повторный запуск молча
# пропускает шаги и завершается «успехом» без ISO (случай 2026-09-26)
rm -rf -- "$REPO/work"

# Выход в iso/out (читает тестовый стенд vm/create-test-vm.sh),
# профиль — явным путём от корня репозитория
exec mkarchiso -v -w "$REPO/work" -o "$REPO/iso/out" "$REPO/iso"
