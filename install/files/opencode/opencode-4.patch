@@ -0,0 +1,181 @@
+/** @jsxImportSource @opentui/solid */
+import { expect, test } from "bun:test"
+import { For } from "solid-js"
+import type { ScrollBoxRenderable } from "@opentui/core"
+import type { GlobalEvent } from "@opencode-ai/sdk/v2"
+import type { JSX } from "@opentui/solid"
+import { tmpdir } from "../../../fixture/fixture"
+import { json, mount, wait } from "./sync-fixture"
+import { useSync } from "../../../../src/context/sync"
+
+const sessionID = "ses_window"
+const session = {
+  id: sessionID,
+  title: "window",
+  time: { created: 0, updated: 0 },
+  version: "1.19.0",
+  directory: "/tmp/opencode/packages/tui",
+}
+
+// Timestamps stay 13 digits long so the string search key (`time.created +
+// id`) orders exactly like the numeric time comparison in compareMessage.
+const BASE = 1791900000000
+
+function assistant(id: string, created: number) {
+  return {
+    id,
+    sessionID,
+    role: "assistant" as const,
+    agent: "build",
+    modelID: "model",
+    providerID: "test",
+    mode: "build",
+    parentID: "msg_user",
+    path: { cwd: session.directory, root: session.directory },
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time: { created, completed: created + 1 },
+  }
+}
+
+function initialMessages() {
+  return Array.from({ length: 100 }, (_, index) => ({
+    info: assistant(`msg_${String(index).padStart(3, "0")}`, BASE + index),
+    parts: [],
+  }))
+}
+
+function fetchSession(url: URL) {
+  if (url.pathname === `/session/${sessionID}`) return json(session)
+  if (url.pathname === `/session/${sessionID}/message`) return json(initialMessages())
+  if (url.pathname === `/session/${sessionID}/todo` || url.pathname === `/session/${sessionID}/diff`)
+    return json([])
+  return undefined
+}
+
+function global(payload: GlobalEvent["payload"]): GlobalEvent {
+  return { directory: "/tmp/other", project: "proj_test", payload }
+}
+
+// A fresh agent message: the list grows past the window, which is the exact
+// moment the oldest message used to be evicted from the top.
+function emitAgentMessage(emit: (event: GlobalEvent) => void, seq: number) {
+  emit(
+    global({
+      id: `evt_agent_message_${seq}`,
+      type: "message.updated",
+      properties: { sessionID, info: assistant(`msg_${900 + seq}`, BASE + 100 + seq) },
+    }),
+  )
+}
+
+// Mirrors the session view: sticky-bottom scrollbox with fixed-height
+// message rows, so content moves are visible in the captured frame.
+function Transcript(props: { onScroll: (scroll: ScrollBoxRenderable) => void }) {
+  const sync = useSync()
+  return (
+    <scrollbox ref={props.onScroll} stickyScroll={true} stickyStart="bottom" height={10} width={40}>
+      <For each={sync.data.message[sessionID] ?? []}>
+        {(message) => (
+          <box height={4}>
+            <text>{message.id}</text>
+          </box>
+        )}
+      </For>
+    </scrollbox>
+  )
+}
+
+async function openSession(state: string, children?: () => JSX.Element) {
+  await Bun.write(`${state}/kv.json`, "{}")
+  return mount(fetchSession, state, children)
+}
+
+test("the message window holds while the reader is scrolled up", async () => {
+  await using tmp = await tmpdir()
+
+  let scroll: ScrollBoxRenderable | undefined
+  const { app, emit, sync } = await openSession(tmp.path, () => (
+    <Transcript onScroll={(value) => (scroll = value)} />
+  ))
+
+  try {
+    // Same gate the session route registers for the active session.
+    const atBottom = () => {
+      if (!scroll || scroll.isDestroyed) return true
+      return scroll.scrollTop >= scroll.scrollHeight - scroll.viewport.height
+    }
+    sync.message.setEvictionGate(sessionID, atBottom)
+
+    await sync.session.sync(sessionID)
+    await wait(() => sync.data.message[sessionID]?.length === 100)
+
+    await app.renderOnce()
+    await app.renderOnce()
+
+    // The reader scrolls up by 12 rows and stays away from the bottom.
+    scroll!.scrollBy(-12)
+    await app.renderOnce()
+    const scrollTopBefore = scroll!.scrollTop
+    const frameBefore = app.captureCharFrame()
+
+    emitAgentMessage(emit, 0)
+    await wait(() => sync.data.message[sessionID]?.length === 101)
+    await app.renderOnce()
+    await app.renderOnce()
+
+    // Nothing is evicted from the top, so the visible transcript does not
+    // move: scrollTop stays and the same message rows remain on screen.
+    expect(sync.data.message[sessionID][0].id).toBe("msg_000")
+    expect(scroll!.scrollTop).toBe(scrollTopBefore)
+    expect(app.captureCharFrame()).toBe(frameBefore)
+  } finally {
+    app.renderer.destroy()
+  }
+})
+
+test("the window shrinks back in one pass once the reader is at the bottom", async () => {
+  await using tmp = await tmpdir()
+
+  const { app, emit, sync } = await openSession(tmp.path)
+
+  try {
+    // The reader is scrolled up: every new message only appends.
+    sync.message.setEvictionGate(sessionID, () => false)
+    await sync.session.sync(sessionID)
+    await wait(() => sync.data.message[sessionID]?.length === 100)
+
+    for (let seq = 0; seq < 5; seq++) emitAgentMessage(emit, seq)
+    await wait(() => sync.data.message[sessionID]?.length === 105)
+
+    // The reader returns to the bottom: the next message drops everything
+    // accumulated above the window in a single pass.
+    sync.message.setEvictionGate(sessionID, () => true)
+    emitAgentMessage(emit, 5)
+    await wait(() => sync.data.message[sessionID].at(-1)?.id === "msg_905")
+
+    expect(sync.data.message[sessionID]).toHaveLength(100)
+    expect(sync.data.message[sessionID][0].id).toBe("msg_006")
+  } finally {
+    app.renderer.destroy()
+  }
+})
+
+test("a session without a registered gate keeps shrinking its window", async () => {
+  await using tmp = await tmpdir()
+
+  const { app, emit, sync } = await openSession(tmp.path)
+
+  try {
+    await sync.session.sync(sessionID)
+    await wait(() => sync.data.message[sessionID]?.length === 100)
+
+    emitAgentMessage(emit, 0)
+    await wait(() => sync.data.message[sessionID].at(-1)?.id === "msg_900")
+
+    expect(sync.data.message[sessionID]).toHaveLength(100)
+    expect(sync.data.message[sessionID][0].id).toBe("msg_001")
+  } finally {
+    app.renderer.destroy()
+  }
+})
