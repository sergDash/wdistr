 packages/tui/src/routes/session/index.tsx     |  21 ++
 .../cmd/tui/scroll-window-eviction.test.tsx   | 181 ++++++++++++++++++
 .../tui/test/cli/cmd/tui/sync-fixture.tsx     |   5 +-
 4 files changed, 249 insertions(+), 16 deletions(-)
