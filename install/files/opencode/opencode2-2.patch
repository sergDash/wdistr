+// The time left in a usage window, in the compact form the sidebar has room for:
+// 4h 50m for the 5-hour window, 4d 8h for the weekly and monthly ones.
+function remaining(resetAt: number, now: number) {
+  const minutes = Math.floor(Math.max(0, resetAt - now) / 60_000)
+  if (minutes >= 1_440) return `${Math.floor(minutes / 1_440)}d ${Math.floor((minutes % 1_440) / 60)}h`
+  if (minutes >= 60) return `${Math.floor(minutes / 60)}h ${minutes % 60}m`
+  return `${minutes}m`
+}
+
+// Percent follows the label so it stays left-aligned; the time starts at a fixed
+// column below, which keeps it from sticking to the percent on longer labels.
+function usageLine(label: string, meter: UsageLimitsMeter, now: number) {
+  const prefix = `${label}: ${meter.percent}%`
+  return `${prefix}${" ".repeat(Math.max(1, 16 - prefix.length))}${remaining(meter.resetsAt, now)}`
+}
+
 export function SidebarContext(props: { context: Plugin.Context; sessionID: string }) {
   const theme = props.context.theme
+  const [now, setNow] = createSignal(Date.now())
+  const [limits, setLimits] = createSignal<UsageLimitsInfo | undefined>()
   const msg = createMemo(() => props.context.data.session.message.list(props.sessionID))
   const session = createMemo(() => props.context.data.session.get(props.sessionID))
   const models = createMemo(() => props.context.data.location.model.list(session()?.location))
@@ -66,27 +84,80 @@ export function SidebarContext(props: { context: Plugin.Context; sessionID: stri
     contextUsage(msg(), props.context.data.location.model.list(session()?.location), session()?.revert?.messageID),
   )
 
+  // Go meters: how long until the 5-hour, weekly and monthly allowances reset.
+  const meters = createMemo(() => {
+    const go = limits()?.go
+    if (!go) return undefined
+    const current = now()
+    return {
+      rolling: usageLine("5-hour", go.rolling, current),
+      weekly: usageLine("Weekly", go.weekly, current),
+      monthly: usageLine("Monthly", go.monthly, current),
+    }
+  })
+
+  onMount(() => {
+    let fetched = 0
+    const ref = () => props.context.location ?? props.context.data.location.default()
+    const load = async () => {
+      const client = props.context.client
+      // A bare location without Console or Go has no meters, which is not an error.
+      if (!client) return
+      const response = await client.experimental.usage
+        .limits({ location: ref() })
+        .catch(() => undefined)
+      if (!response) return
+      setLimits(response.data ?? undefined)
+    }
+    const refresh = (force: boolean) => {
+      // Percent moves as requests run, so a minute keeps it close without asking
+      // the Go endpoint on every label tick.
+      if (!force && Date.now() - fetched < 60_000) return
+      fetched = Date.now()
+      void load()
+    }
+    refresh(true)
+    // Reset instants and percentages change slowly compared with the clock, so the
+    // server is re-read once a minute while the labels themselves tick every 30 seconds.
+    const timer = setInterval(() => {
+      setNow(Date.now())
+      refresh(false)
+    }, 30_000)
+    onCleanup(() => clearInterval(timer))
+  })
+
   return (
