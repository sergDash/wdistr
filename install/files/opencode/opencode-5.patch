+// The Go inference gateway exposes the allowance windows, but only through this
+// Console endpoint: the models API carries prices, not the meters.
+const GO_USAGE = "https://opencode.ai/zen/go/v1/usage"
+const AUTH_FILE = path.join(Global.Path.data, "auth.json")
+
+type GoMeter = {
+  percent: number
+  status: string
+  resetsAt: string
+}
+
+type GoMeters = {
+  rolling: GoMeter
+  weekly: GoMeter
+  monthly: GoMeter
+}
+
+// The time left in a usage window, in the compact form the sidebar has room for:
+// 4h 50m for the 5-hour window, 4d 8h for the weekly and monthly ones.
+function remaining(resetAt: number, now: number) {
+  if (!Number.isFinite(resetAt)) return "—"
+  const minutes = Math.floor(Math.max(0, resetAt - now) / 60_000)
+  if (minutes >= 1_440) return `${Math.floor(minutes / 1_440)}d ${Math.floor((minutes % 1_440) / 60)}h`
+  if (minutes >= 60) return `${Math.floor(minutes / 60)}h ${minutes % 60}m`
+  return `${minutes}m`
+}
+
+// Percent follows the label so it stays left-aligned; the time starts at a fixed
+// column below, which keeps it from sticking to the percent on longer labels.
+function usageLine(label: string, meter: GoMeter, now: number) {
+  const prefix = `${label}: ${meter.percent}%`
+  const time = remaining(Date.parse(meter.resetsAt), now)
+  return `${prefix}${" ".repeat(Math.max(1, 16 - prefix.length))}${time}`
+}
+
+async function goKey() {
+  if (process.env.OPENCODE_API_KEY) return process.env.OPENCODE_API_KEY
+  const auth = JSON.parse(await readFile(AUTH_FILE, "utf8"))
+  return auth["opencode-go"]?.key as string | undefined
+}
+
+async function goMeters() {
+  const key = await goKey()
+  if (!key) return undefined
+  const response = await fetch(GO_USAGE, {
+    headers: {
+      authorization: `Bearer ${key}`,
+      accept: "application/json",
+      "user-agent": "opencode/1",
+    },
+  })
+  if (!response.ok) return undefined
+  const body = (await response.json()) as { usage?: GoMeters }
+  return body.usage
+}
