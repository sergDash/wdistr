[Unit]
Description=wdistr: автообновление flatpak-программ
# Цепочка After= задаёт порядок очереди при одновременном старте:
# система → AUR → flatpak (фактическая блокировка — flock в ExecStart).
After=network-online.target wdistr-sys-update.service wdistr-aur-update.service
Wants=network-online.target
# Сбой (обычно — сеть) не ждёт недельного окна: повтор через 4 часа
OnFailure=wdistr-update-retry@wdistr-flatpak-update.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock /run/wdistr.lock /usr/local/bin/wdistr-flatpak-update
