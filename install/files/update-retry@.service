[Unit]
Description=wdistr: повтор %i через 4 часа после сбоя автообновления

[Service]
Type=oneshot
# Опыт 2026-10-16: сетевой сбой посреди обновления не должен ждать
# следующего недельного окна таймера — OnFailure в сервисе обновления
# активирует этот шаблон, он спит 4 часа и запускает упавшее обновление
# заново. Конкуренцию с очередью разрулит flock в самом обновлении.
# --no-block обязателен: без него start блокируется до завершения
# обновления, и при повторном падении OnFailure увидит уже активный
# retry и не создаст следующий — цикл «падение → 4 часа» оборвался бы
# после одной попытки. С no-block retry завершается сразу, а упавший
# сервис при новом падении снова поднимает свежий инстанс.
ExecStart=/bin/sleep 4h
ExecStart=/bin/sh -c "systemctl start --no-block %i.service || true"
