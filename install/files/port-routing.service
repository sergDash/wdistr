[Unit]
Description=Apply port routing rules
After=network-online.target
Wants=network-online.target
#BindsTo=sys-subsystem-net-devices-enp6s0.device
#After=sys-subsystem-net-devices-enp6s0.device

# Шаблон: правила по портам закомментированы, шлюз — демонстрационный
# (123.123.123.123). Чтобы включить: заменить INTERFACE/GW под свою сеть,
# раскомментировать маршруты и правила со своими портами.
[Service]
Type=oneshot
Environment="INTERFACE=enp6s0"
Environment="GW=192.168.0.1"
# Идемпотентность: чистка старых правил с именем «port» — безопасна,
# при пустом шаблоне ничего не находит
ExecStartPre=/bin/bash -c 'ip rule show | grep -w port | while read prio from all rest; do ip rule del $rest; done; true'
# Имя таблицы "port" резолвится только через /etc/iproute2/rt_tables.
# Опыт 2026-10-14: на Arch (iproute2 7.2) каталога /etc/iproute2 нет —
# grep падал «файл не найден», а >> писал в несуществующий путь, юнит
# умирал с exit 1. Ставим каталог и файл перед записью.
ExecStartPre=/bin/bash -c 'mkdir -p /etc/iproute2; touch /etc/iproute2/rt_tables; grep -q "^100 port" /etc/iproute2/rt_tables || echo "100 port" >> /etc/iproute2/rt_tables'
# Ожидание адреса на интерфейсе (нужен свой INTERFACE, иначе зависание
# до таймаута systemd 90 с на машине без такого интерфейса):
#ExecStartPre=/bin/bash -c 'while ! ip addr show dev ${INTERFACE} | grep -q "inet "; do sleep 1; done; sleep 1'

# Маршрут таблицы port и правила по исходящим портам (свои порты):
#ExecStart=/sbin/ip route replace default via ${GW} dev ${INTERFACE} table port
# Веб
#ExecStart=/sbin/ip rule add sport 80 table port
#ExecStart=/sbin/ip rule add sport 443 table port
# Почта: 25/587 — SMTP (отправка), 993/143 — IMAP (чтение)
#ExecStart=/sbin/ip rule add sport 25 table port
#ExecStart=/sbin/ip rule add sport 587 table port
#ExecStart=/sbin/ip rule add sport 993 table port
#ExecStart=/sbin/ip rule add sport 143 table port
# Teamspeak server (если поставите на свой компьютер)
#ExecStart=/sbin/ip rule add sport 9987 table port
# Minecraft server
#ExecStart=/sbin/ip rule add sport 25565 table port
# Игра Rust (сервер)
#ExecStart=/sbin/ip rule add sport 28015 table port
# Игра Project Zomboid (сервер), диапазон 16261–16264
#ExecStart=/sbin/ip rule add sport 16261 table port
#ExecStart=/sbin/ip rule add sport 16262 table port
#ExecStart=/sbin/ip rule add sport 16263 table port
#ExecStart=/sbin/ip rule add sport 16264 table port

# Снятие тех же правил при остановке (раскомментировать парно с ExecStart):
#ExecStop=/sbin/ip rule del sport 80 table port
#ExecStop=/sbin/ip rule del sport 443 table port
#ExecStop=/sbin/ip rule del sport 25 table port
#ExecStop=/sbin/ip rule del sport 587 table port
#ExecStop=/sbin/ip rule del sport 993 table port
#ExecStop=/sbin/ip rule del sport 143 table port
#ExecStop=/sbin/ip rule del sport 9987 table port
#ExecStop=/sbin/ip rule del sport 25565 table port
#ExecStop=/sbin/ip rule del sport 28015 table port
#ExecStop=/sbin/ip rule del sport 16261 table port
#ExecStop=/sbin/ip rule del sport 16262 table port
#ExecStop=/sbin/ip rule del sport 16263 table port
#ExecStop=/sbin/ip rule del sport 16264 table port
#ExecStop=/sbin/ip route del default via ${GW} dev ${INTERFACE} table port

# Пустой успешный запуск, пока правила закомментированы —
# юнит стартует и завершается без ошибок
ExecStart=/bin/true

RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
