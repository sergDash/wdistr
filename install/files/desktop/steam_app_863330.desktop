[Desktop Entry]
Type=Application
Name=RPG in a Box Demo
Exec=/usr/bin/flatpak run com.valvesoftware.Steam steam://rungameid/863330
Icon=steam_app_863330
# Опыт 2026-10-26: Godot-движок объявляет в WM_CLASS имя движка
# (instance "Godot_Engine"), class — заголовок окна игры, у демо это
# "RPG in a Box (Demo Version)" (xprop WM_CLASS). Cinnamon ищет
# .desktop по class-части.
StartupWMClass=RPG in a Box (Demo Version)
Terminal=false
Categories=Game;
