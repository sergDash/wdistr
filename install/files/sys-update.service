[Unit]
Description=wdistr: автообновление системы (pacman -Syu)
After=network-online.target
Wants=network-online.target
# Сбой (обычно — сеть) не ждёт недельного окна: повтор через 4 часа
# (шаблон wdistr-update-retry@, опыт 2026-10-16)
OnFailure=wdistr-update-retry@wdistr-sys-update.service

[Service]
Type=oneshot
# flock вокруг скрипта: /run/wdistr.lock — общая очередь всех
# автообновлений и проверки Timeshift. Блокировка держится, пока скрипт
# выполняется, — конкурирующий запуск встаёт в очередь, а не падает.
# Опыт 2026-10-11: без неё таймеры после пропущенного окна (Persistent)
# стартовали одновременно и дрались о /var/lib/pacman/db.lck, а
# почасовая проверка Timeshift могла снять снапшот посреди распаковки.
ExecStart=/usr/bin/flock /run/wdistr.lock /usr/local/bin/wdistr-sys-update
