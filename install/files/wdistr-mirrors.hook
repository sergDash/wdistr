# Восстанавливает список зеркал wdistr в живой среде после установки
# или обновления пакета pacman-mirrorlist: сам пакет при распаковке
# затирает /etc/pacman.d/mirrorlist стоковым списком (все зеркала мира).
# Источник — /usr/local/share/wdistr/mirrorlist; в профиль ISO оба
# кладёт regen-custom-commands.py.
# Хук ставится ТОЛЬКО в живую среду (решение 2026-10-15): в целевую
# он не доставляется — там mirrorlist поставляется один раз при
# установке, дальше это файл пользователя, и pacman-mirrorlist бережёт
# его как backup-файл (правки переживают обновления, новый сток уходит
# в .pacnew). В живой среде хук нужен при сборке: pacman-mirrorlist
# ставится там свежий и затирает список.
# Подпись сборочного хука zzzz99 (он удаляет помеченные хуки профиля
# после сборки) сюда НЕ добавлять: хук должен пережить сборку.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = pacman-mirrorlist

[Action]
Description = Applying wdistr mirrorlist (mirrors.txt)...
When = PostTransaction
Depends = pacman-mirrorlist
Depends = coreutils
Exec = /usr/bin/cp -f /usr/local/share/wdistr/mirrorlist /etc/pacman.d/mirrorlist
