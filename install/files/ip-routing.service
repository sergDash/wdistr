[Unit]
Description=Apply ip routing rules
After=network-online.target
Wants=network-online.target
#BindsTo=sys-subsystem-net-devices-enp6s0.device
#After=sys-subsystem-net-devices-enp6s0.device

[Service]
Type=oneshot
Environment="INTERFACE=enp6s0"
Environment="GW=192.168.0.1"

ExecStartPre=/bin/bash -c 'while ! ip addr show dev ${INTERFACE} | grep -q "inet "; do sleep 1; done; sleep 1'

#ExecStart=/sbin/ip route replace 185.82.127.83 via ${GW} dev ${INTERFACE}
#ExecStart=/sbin/ip route replace 45.130.212.163 via ${GW} dev ${INTERFACE}
ExecStart=/sbin/ip route replace 62.113.107.38 via ${GW} dev ${INTERFACE}
ExecStart=/sbin/ip route replace 130.17.16.223 via ${GW} dev ${INTERFACE}

#ExecStop=/sbin/ip route del 185.82.127.83 via ${GW} dev ${INTERFACE}
#ExecStop=/sbin/ip route del 45.130.212.163 via ${GW} dev ${INTERFACE}
ExecStop=/sbin/ip route del 62.113.107.38 via ${GW} dev ${INTERFACE}
ExecStop=/sbin/ip route del 130.17.16.223 via ${GW} dev ${INTERFACE}

RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
