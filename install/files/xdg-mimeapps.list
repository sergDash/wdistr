# Системные ассоциации файлов по умолчанию (wdistr).
#
# Папки открывает Nemo (файловый менеджер Cinnamon), а не VSCodium:
# codium.desktop объявляет MimeType=inode/directory и в mimeinfo.cache
# стоит первым по алфавиту среди держателей каталога (codium;
# dev.pragtical.Pragtical; nemo; org.gnome.baobab) — без этой записи
# подбор отдавал его (опыт 2026-10-15: при подключении диска
# открывался редактор, а не файловый менеджер).
# Файл действует на всех пользователей; выбор пользователя в
# ~/.config/mimeapps.list его перекрывает — это ожидаемо.
#
# Ассоциации по умолчанию (решение 2026-10-16, уточнение 2026-10-18):
# значения с рабочей машины. Категории Cinnamon «Программы по
# умолчанию» отображаются на MIME-типы; здесь — системные дефолты,
# пользователь может переключить в настройках.
[Default Applications]
inode/directory=nemo.desktop

# Интернет.Почта: Thunderbird (вместо DeltaChat)
x-scheme-handler/mailto=org.mozilla.Thunderbird.desktop
message/rfc822=org.mozilla.Thunderbird.desktop
x-scheme-handler/mid=org.mozilla.Thunderbird.desktop
text/calendar=org.mozilla.Thunderbird.desktop
x-scheme-handler/webcal=org.mozilla.Thunderbird.desktop
x-scheme-handler/webcals=org.mozilla.Thunderbird.desktop

# Мультимедия.Фото: Viewnior (вместо Firefox)
image/bmp=viewnior.desktop
image/gif=viewnior.desktop
image/jpeg=viewnior.desktop
image/jpg=viewnior.desktop
image/pjpeg=viewnior.desktop
image/png=viewnior.desktop
image/svg+xml=viewnior.desktop
image/svg+xml-compressed=viewnior.desktop
image/tiff=viewnior.desktop
image/vnd.wap.wbmp=viewnior.desktop
image/x-bmp=viewnior.desktop
image/x-gray=viewnior.desktop
image/x-icb=viewnior.desktop
image/x-ico=viewnior.desktop
image/x-pcx=viewnior.desktop
image/x-png=viewnior.desktop
image/x-portable-anymap=viewnior.desktop
image/x-portable-bitmap=viewnior.desktop
image/x-portable-graymap=viewnior.desktop
image/x-portable-pixmap=viewnior.desktop
image/x-xbitmap=viewnior.desktop
image/x-xpixmap=viewnior.desktop
# webp — формат веб-изображений; по умолчанию открывался браузером
# (пожелание 2026-10-20)
image/webp=viewnior.desktop

# .ai (Adobe Illustrator): VectorCraft (пожелание 2026-10-23, значение
# с рабочей машины — xdg-mime query default application/illustrator
# отвечает VectorCraft). Тип application/illustrator даёт глоб *.ai из
# freedesktop; сам .desktop VectorCraft тип не объявляет (MimeType=
# image/svg+xml;application/pdf;) — это отдельная тема для списка
# «Открыть с помощью» Cinnamon, на дефолт по mimeapps.list не влияет.
application/illustrator=ai.storyteller.vectorcraft.desktop

# .drawio (diagrams.net): drawio (пожелание 2026-10-23, проверено на
# рабочей машине: filetype → application/vnd.jgraph.mxfile, default →
# drawio-desktop.desktop). Тип и глоб *.drawio объявляет сам пакет
# (drawio.xml из официального .deb, pacman-хук update-mime-database
# обновляет базу при установке) — строка фиксирует выбор дефолта;
# до установки пакета ключ безвреден, MIME-типа ещё нет.
application/vnd.jgraph.mxfile=drawio-desktop.desktop

# Офис.Текст: WordCraft (вместо LibreOffice Writer)
application/vnd.openxmlformats-officedocument.wordprocessingml.document=ai.storyteller.wordcraft.desktop
application/vnd.ms-word.document.macroEnabled.12=ai.storyteller.wordcraft.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.template=ai.storyteller.wordcraft.desktop
application/vnd.ms-word.template.macroEnabled.12=ai.storyteller.wordcraft.desktop
application/msword=ai.storyteller.wordcraft.desktop
application/msword-template=ai.storyteller.wordcraft.desktop
application/vnd.oasis.opendocument.text=ai.storyteller.wordcraft.desktop
application/rtf=ai.storyteller.wordcraft.desktop
text/rtf=ai.storyteller.wordcraft.desktop

# Офис.Таблица: GridCraft (вместо LibreOffice Calc). Строка GUI
# «Предпочтительные приложения → Таблица» в Cinnamon читает легаси-тип
# application/msexcel (cs_default.py, preferred_app_defs["office"]),
# а не реальные MIME-типы — без этой записи GIO отвечал LibreOffice
# Calc (он декларирует легаси-тип в своём .desktop), хотя xlsx/ods/csv
# открывались в GridCraft штатно (опыт установки 2026-10-19).
# Соседняя строка «Текст» показывала WordCraft именно потому, что
# application/msword в списке уже был.
application/msexcel=ai.storyteller.gridcraft.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=ai.storyteller.gridcraft.desktop
application/vnd.ms-excel.sheet.macroEnabled.12=ai.storyteller.gridcraft.desktop
application/vnd.ms-excel.sheet.binary.macroEnabled.12=ai.storyteller.gridcraft.desktop
application/vnd.oasis.opendocument.spreadsheet=ai.storyteller.gridcraft.desktop
text/csv=ai.storyteller.gridcraft.desktop
text/tab-separated-values=ai.storyteller.gridcraft.desktop

# Офис.PDF: Okular (вместо Firefox)
application/pdf=okularApplication_pdf.desktop

# Офис.Исходный текст: VSCodium (пожелание 2026-10-18). Категория
# Cinnamon «Исходный текст» в настройках по умолчанию пишет MIME
# text/x-python (cs_default.py, preferred_app_defs["office"])
text/x-python=codium.desktop

# Система.Текст: VSCodium (пожелание 2026-10-18) — редактор кода
# открыт и обычный текст. Категория Cinnamon «Текст» пишет
# text/plain (cs_default.py, preferred_app_defs["system"])
text/plain=codium.desktop
