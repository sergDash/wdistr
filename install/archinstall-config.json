    "custom_commands": [
        "sed -i '/#\\[multilib\\]/,/^#Include/ s/^#//' /etc/pacman.conf",
        "usermod -s /usr/bin/fish root && usermod -s /usr/bin/fish user && sed -i 's|^SHELL=.*|SHELL=/usr/bin/fish|' /etc/default/useradd",
        "rm -f /etc/xdg/autostart/picom.desktop",
        "mkdir -p $(dirname /usr/local/bin/wdistr-fix-gfx) && echo '' | base64 -d > /usr/local/bin/wdistr-fix-gfx && chmod 755 /usr/local/bin/wdistr-fix-gfx",
        "mkdir -p /home/user/.ssh && echo 'c3NoLWVkMjU1MTkgQUFBQUMzTnphQzFsWkRJMU5URTVBQUFBSUl0bWJoWFk1dGl6OWUyZkZrNE9COFRqYXZ0MVpPa1c3dTRNd3BNQlhLQkIgd2Rpc3RyLWJ1aWxkQHdkaXN0ci1ob3N0' | base64 -d > /home/user/.ssh/authorized_keys && chmod 700 /home/user/.ssh && chmod 600 /home/user/.ssh/authorized_keys && chown -R user:user /home/user/.ssh",
        "mkdir -p /etc/xdg/autostart && printf '[Desktop Entry]\\nType=Application\\nName=wdistr fix graphics\\nExec=/usr/local/bin/wdistr-fix-gfx\\nOnlyShowIn=XFCE;\\n' > /etc/xdg/autostart/wdistr-fix-gfx.desktop",
        "mkdir -p $(dirname /etc/keyd/default.conf) && echo '' | base64 -d > /etc/keyd/default.conf",
        "mkdir -p $(dirname /usr/local/bin/keyd-toggle-layout) && echo '' | base64 -d > /usr/local/bin/keyd-toggle-layout && chmod 755 /usr/local/bin/keyd-toggle-layout",
        "mkdir -p $(dirname /etc/gtk-3.0/settings.ini) && echo '' | base64 -d > /etc/gtk-3.0/settings.ini",
        "mkdir -p $(dirname /usr/local/share/keyd/us.txt) && echo '' | base64 -d | gzip -d > /usr/local/share/keyd/us.txt",
        "mkdir -p $(dirname /usr/local/share/keyd/ru.txt) && echo '' | base64 -d | gzip -d > /usr/local/share/keyd/ru.txt",
        "mkdir -p $(dirname /usr/local/bin/wdistr-first-boot) && echo '' | base64 -d > /usr/local/bin/wdistr-first-boot && chmod 755 /usr/local/bin/wdistr-first-boot",
        "mkdir -p $(dirname /etc/systemd/system/wdistr-first-boot.service) && echo '' | base64 -d > /etc/systemd/system/wdistr-first-boot.service",
        "systemctl enable wdistr-first-boot.service"
    ],
