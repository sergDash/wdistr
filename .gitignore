# Артефакты виртуальных машин (ISO, диски и флаг проверки не версионируются;
# сам файл сумм sha256sums.txt — наоборот, входит в репозиторий)
vm/*.iso
vm/*.part
vm/*.vdi
vm/*.verified

# Выходные файлы сборок archiso (появятся при профиле)
out/
work/
# Временный тарбол для передачи профиля в сборочную VM
iso-profile.tgz

# Бинарник opencode для ISO (170 МБ, в git не версионируется):
# кладётся перед сборкой ISO, см. Cards/Сборка ISO archiso
iso/airootfs/usr/local/bin/opencode-*

# Шрифты Windows для ISO (342 МиБ, в git не версионируются):
# копируются из install/files/winfonts перед сборкой, см.
# Cards/Шрифты - Windows-шрифты.md
iso/airootfs/usr/share/fonts/winfonts/

# Образ Windows 11 для извлечения шрифтов (6,2 ГиБ, в git не версионируется):
# качается wget -c в корень, см. Cards/Шрифты - Windows-шрифты.md
win11-eval.iso

# Извлечённые из него Windows-шрифты (342 МиБ, механизм доставки в ISO
# ещё не выбран), см. Cards/Шрифты - Windows-шрифты.md
install/files/winfonts/

# Локальные настройки редактора (файл расширения закладок VS Code)
.vscode/

# Лог сборки ISO (создаётся mkarchiso-запуском в корне репозитория)
build.log

# База рейтинга зеркал (создаётся rate-mirrors.py, локальная история)
mirrors.db
